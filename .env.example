# Application
NODE_ENV=development
PORT=3000

# Database (Required)
# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/habari_assistant?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/habari_assistant?schema=public

# OpenAI (Required)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Telegram Bot (Optional)
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# WhatsApp Business API (Optional)
# Get these from Meta Business Suite: https://business.facebook.com
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# JWT Secret (Optional)
# Generate a random string for JWT token signing
JWT_SECRET=your_jwt_secret_here
